{
  "name": "field-warfare",
  "version": "4.0.3",
  "description": "Military FPS, solo against AI bots or on the local network, with a built-in game server.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "package": "node scripts/package.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:touch": "node scripts/touch-check.mjs",
    "test:gamepad": "node scripts/gamepad-check.mjs",
    "app:build": "node scripts/app.mjs",
    "app:start": "node scripts/app.mjs && electron .",
    "app:win": "node scripts/app.mjs && electron-builder --win",
    "app:mac": "node scripts/app.mjs && electron-builder --mac",
    "app:ios": "node scripts/app.mjs && cap sync ios"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "three": "0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@playwright/test": "1.56.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.10",
    "fflate": "^0.8.3",
    "field-warfare-ar": "file:native/ar",
    "field-warfare-lan-host": "file:native/lan-host",
    "sharp": "0.35.5"
  },
  "main": "build/desktop/main.mjs",
  "build": {
    "appId": "com.aerofred.fieldwarfare",
    "productName": "Field Warfare",
    "copyright": "Copyright (c) 2026 aerofred",
    "directories": {
      "output": "releases/app",
      "buildResources": "build/resources"
    },
    "files": [
      "build/desktop/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FieldWarfare-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "FieldWarfare-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/resources/icon.png",
      "category": "public.app-category.action-games",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Field Warfare finds other players’ games on your local network and announces yours.",
        "NSBonjourServices": [
          "_fieldwarfare._tcp"
        ]
      },
      "artifactName": "FieldWarfare-${version}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "FieldWarfare-${version}-mac.${ext}"
    }
  }
}
